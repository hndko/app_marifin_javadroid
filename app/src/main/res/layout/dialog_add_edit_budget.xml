<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg"
    android:background="@color/surface">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bikin Budget Baru"
        android:textSize="@dimen/text_lg"
        android:fontFamily="sans-serif-bold"
        android:textColor="@color/on_surface"
        android:layout_marginBottom="@dimen/spacing_md" />

    <!-- 1. Budget Name -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_budget_name"
        style="@style/Widget.MariFin.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nama Anggaran"
        app:startIconDrawable="@drawable/ic_budget"
        android:layout_marginBottom="@dimen/spacing_sm">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_budget_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 2. Limit Amount -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_budget_limit"
        style="@style/Widget.MariFin.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Batas Nominal (Rp)"
        app:startIconDrawable="@drawable/ic_wallet_card"
        android:layout_marginBottom="@dimen/spacing_sm">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_budget_limit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 3. Period Selector -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_budget_period"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Periode"
        app:boxStrokeColor="@color/primary"
        app:boxCornerRadiusTopStart="@dimen/radius_md"
        app:boxCornerRadiusTopEnd="@dimen/radius_md"
        app:boxCornerRadiusBottomStart="@dimen/radius_md"
        app:boxCornerRadiusBottomEnd="@dimen/radius_md"
        android:layout_marginBottom="@dimen/spacing_lg">

        <AutoCompleteTextView
            android:id="@+id/actv_budget_period"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_budget"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_cancel"
            android:textColor="@color/gray_600"
            android:layout_marginEnd="@dimen/spacing_sm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_budget"
            style="@style/Widget.MariFin.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[✓] Simpan" />
    </LinearLayout>

</LinearLayout>
