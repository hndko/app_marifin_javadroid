<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/Widget.MariFin.CardView"
    app:cardElevation="@dimen/elevation_low"
    android:layout_marginHorizontal="@dimen/spacing_base"
    android:layout_marginVertical="@dimen/spacing_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_base">

        <!-- Top Header: Name, Deadline & Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_goal_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dana Darurat"
                    android:textSize="@dimen/text_base"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:id="@+id/tv_goal_deadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target: 31 Des 2026"
                    android:textSize="@dimen/text_xs"
                    android:textColor="@color/gray_500"
                    android:layout_marginTop="@dimen/spacing_2xs" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_goal_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50%"
                android:textSize="@dimen/text_xs"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/primary"
                android:background="@drawable/bg_badge_primary"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:paddingVertical="@dimen/spacing_2xs" />

            <ImageButton
                android:id="@+id/btn_goal_delete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                app:tint="@color/gray_400"
                android:layout_marginStart="@dimen/spacing_xs"
                android:contentDescription="@string/action_delete"
                android:tooltipText="@string/action_delete" />
        </LinearLayout>

        <!-- Progress Bar Indicator -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_goal_utilization"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progress="50"
            app:indicatorColor="@color/primary"
            app:trackColor="@color/gray_200"
            app:trackCornerRadius="4dp"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <!-- Saved vs Target & Contribute Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_goal_saved_vs_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terkumpul: Rp15jt / Rp30jt"
                    android:textSize="@dimen/text_xs"
                    android:textColor="@color/gray_700" />

                <TextView
                    android:id="@+id/tv_goal_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kurang: Rp15.000.000"
                    android:textSize="@dimen/text_xs"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/gray_500"
                    android:layout_marginTop="@dimen/spacing_2xs" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_contribute_goal"
                style="@style/Widget.MariFin.Button"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="[+] Setor"
                android:textSize="@dimen/text_xs"
                android:paddingHorizontal="@dimen/spacing_md" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
