<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/spacing_2xl">

    <!-- Slide Visual Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="160dp"
        android:layout_height="160dp"
        style="@style/Widget.MariFin.CardView"
        app:cardCornerRadius="80dp"
        app:cardBackgroundColor="@color/primary_container"
        android:layout_marginBottom="@dimen/spacing_2xl">

        <ImageView
            android:id="@+id/iv_slide_icon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_person"
            app:tint="@color/primary"
            android:contentDescription="Ilustrasi Onboarding" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Slide Title -->
    <TextView
        android:id="@+id/tv_slide_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selamat Datang di MariFin"
        android:textSize="@dimen/text_2xl"
        android:fontFamily="sans-serif-bold"
        android:textColor="@color/on_surface"
        android:gravity="center"
        android:layout_marginBottom="@dimen/spacing_md" />

    <!-- Slide Description -->
    <TextView
        android:id="@+id/tv_slide_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aplikasi pencatatan keuangan pintar untuk membantumu mengelola arus kas, budget, dan rekening secara cerdas."
        android:textSize="@dimen/text_base"
        android:textColor="@color/gray_600"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />

</LinearLayout>
