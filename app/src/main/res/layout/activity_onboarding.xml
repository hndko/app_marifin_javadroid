<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top Bar with Branding & Skip button -->
    <LinearLayout
        android:id="@+id/layout_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:paddingVertical="@dimen/spacing_base">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_marifin_logo"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="@dimen/text_base"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/primary"
                android:layout_marginStart="@dimen/spacing_sm" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_skip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Lewati"
            android:textColor="@color/gray_600"
            android:textSize="@dimen/text_xs"
            app:cornerRadius="18dp"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="0dp"
            android:backgroundTint="@color/surface_variant"
            app:strokeWidth="0dp"
            style="@style/Widget.Material3.Button.TextButton" />
    </LinearLayout>

    <!-- ViewPager2 for Slides -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layout_bottom"
        android:layout_below="@id/layout_top" />

    <!-- Bottom Controls -->
    <LinearLayout
        android:id="@+id/layout_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="@dimen/spacing_2xl"
        android:paddingVertical="@dimen/spacing_xl">

        <!-- Modern Dot Indicators -->
        <LinearLayout
            android:id="@+id/layout_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="@dimen/spacing_sm">

            <View
                android:id="@+id/dot_1"
                android:layout_width="24dp"
                android:layout_height="8dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_indicator_active" />

            <View
                android:id="@+id/dot_2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_indicator_inactive" />

            <View
                android:id="@+id/dot_3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_indicator_inactive" />

            <View
                android:id="@+id/dot_4"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_indicator_inactive" />

            <View
                android:id="@+id/dot_5"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_indicator_inactive" />
        </LinearLayout>

        <!-- Steps Count Text -->
        <TextView
            android:id="@+id/tv_step_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Langkah 1 dari 5"
            android:textSize="@dimen/text_xs"
            android:textColor="@color/gray_500"
            android:layout_marginBottom="@dimen/spacing_lg" />

        <!-- Next / Action Button (constrained max width for tablets) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_next"
            android:layout_width="match_parent"
            android:maxWidth="460dp"
            android:layout_height="54dp"
            android:text="Lanjut"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd"
            app:cornerRadius="@dimen/radius_md"
            style="@style/Widget.MariFin.Button" />
    </LinearLayout>

</RelativeLayout>
