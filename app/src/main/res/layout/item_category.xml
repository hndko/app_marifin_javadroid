<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/Widget.MariFin.CardView"
    app:cardElevation="@dimen/elevation_low"
    android:layout_marginHorizontal="@dimen/spacing_base"
    android:layout_marginVertical="@dimen/spacing_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/spacing_base">

        <!-- Number Column -->
        <TextView
            android:id="@+id/tv_category_number_seq"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:text="1."
            android:textColor="@color/gray_400"
            android:textSize="@dimen/text_sm"
            android:fontFamily="sans-serif-medium" />

        <!-- Category Color Dot & Icon -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_category_color"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="@dimen/elevation_none"
            app:cardBackgroundColor="@color/primary_container">

            <ImageView
                android:id="@+id/iv_category_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_category_default"
                app:tint="@color/primary"
                android:contentDescription="Icon Kategori" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Category Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_md">

            <TextView
                android:id="@+id/tv_category_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Makanan &amp; Minuman"
                android:textSize="@dimen/text_base"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/on_surface" />

            <TextView
                android:id="@+id/tv_category_type_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pengeluaran • Default"
                android:textSize="@dimen/text_xs"
                android:textColor="@color/gray_500"
                android:layout_marginTop="@dimen/spacing_2xs" />
        </LinearLayout>

        <!-- Options Menu Button -->
        <ImageButton
            android:id="@+id/btn_category_menu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/gray_500"
            android:contentDescription="Opsi Kategori"
            android:tooltipText="Opsi Kategori" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
