<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_2xl">

            <!-- Top Header & Greeting -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/spacing_base">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="@dimen/elevation_none"
                    app:cardBackgroundColor="@color/primary_container">

                    <ImageView
                        android:id="@+id/iv_home_avatar"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_person"
                        app:tint="@color/primary"
                        android:contentDescription="Avatar" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tv_greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Halo, Pengguna!"
                        android:textSize="@dimen/text_lg"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/on_surface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mari kelola keuanganmu hari ini"
                        android:textSize="@dimen/text_xs"
                        android:textColor="@color/gray_500" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_notification"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/gray_700"
                    android:contentDescription="Notifikasi" />
            </LinearLayout>

            <!-- Total Net Balance Hero Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MariFin.CardView"
                app:cardBackgroundColor="@color/primary"
                app:contentPadding="@dimen/spacing_lg"
                android:layout_marginHorizontal="@dimen/spacing_base"
                android:layout_marginBottom="@dimen/spacing_base">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total Saldo Bersih"
                            android:textColor="@color/primary_light"
                            android:textSize="@dimen/text_xs"
                            android:fontFamily="sans-serif-medium" />

                        <ImageButton
                            android:id="@+id/btn_toggle_balance"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_eye"
                            app:tint="@color/primary_light"
                            android:contentDescription="Toggle Sembunyikan Saldo" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_home_total_balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp0"
                        android:textSize="@dimen/text_3xl"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/white"
                        android:layout_marginTop="@dimen/spacing_2xs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Horizontal Accounts Carousel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_base"
                android:layout_marginTop="@dimen/spacing_xs"
                android:layout_marginBottom="@dimen/spacing_xs">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Rekening Keuangan"
                    android:textSize="@dimen/text_base"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:id="@+id/btn_manage_accounts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kelola >"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_xs"
                    android:fontFamily="sans-serif-medium"
                    android:padding="@dimen/spacing_xs" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_accounts_carousel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clipToPadding="false"
                android:paddingEnd="@dimen/spacing_base"
                android:layout_marginBottom="@dimen/spacing_base" />

            <!-- Quick Action Grid (4 Actions) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_base"
                android:layout_marginBottom="@dimen/spacing_base">

                <!-- 1. Expense -->
                <LinearLayout
                    android:id="@+id/btn_quick_expense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="@dimen/elevation_none"
                        app:cardBackgroundColor="#FCE8E6">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_arrow_downward"
                            app:tint="@color/expense_red"
                            android:contentDescription="Pengeluaran" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keluar"
                        android:textSize="@dimen/text_xs"
                        android:textColor="@color/gray_700"
                        android:layout_marginTop="@dimen/spacing_2xs" />
                </LinearLayout>

                <!-- 2. Income -->
                <LinearLayout
                    android:id="@+id/btn_quick_income"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="@dimen/elevation_none"
                        app:cardBackgroundColor="#E6F4EA">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_arrow_upward"
                            app:tint="@color/income_green"
                            android:contentDescription="Pemasukan" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Masuk"
                        android:textSize="@dimen/text_xs"
                        android:textColor="@color/gray_700"
                        android:layout_marginTop="@dimen/spacing_2xs" />
                </LinearLayout>

                <!-- 3. Transfer -->
                <LinearLayout
                    android:id="@+id/btn_quick_transfer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="@dimen/elevation_none"
                        app:cardBackgroundColor="@color/primary_container">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_transfer"
                            app:tint="@color/primary"
                            android:contentDescription="Transfer" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Transfer"
                        android:textSize="@dimen/text_xs"
                        android:textColor="@color/gray_700"
                        android:layout_marginTop="@dimen/spacing_2xs" />
                </LinearLayout>

                <!-- 4. FinGPT AI -->
                <LinearLayout
                    android:id="@+id/btn_quick_fingpt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="@dimen/elevation_none"
                        app:cardBackgroundColor="#F3E8FF">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_bolt"
                            app:tint="#9333EA"
                            android:contentDescription="FinGPT AI" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FinGPT"
                        android:textSize="@dimen/text_xs"
                        android:textColor="@color/gray_700"
                        android:layout_marginTop="@dimen/spacing_2xs" />
                </LinearLayout>

            </LinearLayout>

            <!-- Monthly Cash Flow Overview Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MariFin.CardView"
                app:cardElevation="@dimen/elevation_low"
                app:contentPadding="@dimen/spacing_md"
                android:layout_marginHorizontal="@dimen/spacing_base"
                android:layout_marginBottom="@dimen/spacing_base">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ringkasan Arus Kas"
                        android:textSize="@dimen/text_xs"
                        android:textColor="@color/gray_500"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="@dimen/spacing_xs" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pemasukan"
                                android:textSize="@dimen/text_xs"
                                android:textColor="@color/gray_500" />

                            <TextView
                                android:id="@+id/tv_home_income"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+Rp0"
                                android:textColor="@color/income_green"
                                android:fontFamily="sans-serif-bold"
                                android:textSize="@dimen/text_sm"
                                android:layout_marginTop="@dimen/spacing_2xs" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pengeluaran"
                                android:textSize="@dimen/text_xs"
                                android:textColor="@color/gray_500" />

                            <TextView
                                android:id="@+id/tv_home_expense"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-Rp0"
                                android:textColor="@color/expense_red"
                                android:fontFamily="sans-serif-bold"
                                android:textSize="@dimen/text_sm"
                                android:layout_marginTop="@dimen/spacing_2xs" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Arus Bersih"
                                android:textSize="@dimen/text_xs"
                                android:textColor="@color/gray_500" />

                            <TextView
                                android:id="@+id/tv_home_net_flow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rp0"
                                android:textColor="@color/primary"
                                android:fontFamily="sans-serif-bold"
                                android:textSize="@dimen/text_sm"
                                android:layout_marginTop="@dimen/spacing_2xs" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Recent 5 Transactions Header & List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_base"
                android:layout_marginTop="@dimen/spacing_xs"
                android:layout_marginBottom="@dimen/spacing_xs">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Transaksi Terbaru"
                    android:textSize="@dimen/text_base"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:id="@+id/btn_see_all_transactions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lihat Semua >"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_xs"
                    android:fontFamily="sans-serif-medium"
                    android:padding="@dimen/spacing_xs" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_home_recent_transactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <!-- Empty State for Recent Transactions -->
            <TextView
                android:id="@+id/tv_home_empty_tx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Belum ada transaksi tercatat."
                android:textSize="@dimen/text_xs"
                android:textColor="@color/gray_500"
                android:gravity="center"
                android:padding="@dimen/spacing_lg"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
