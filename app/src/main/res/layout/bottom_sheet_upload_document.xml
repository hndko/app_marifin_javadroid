<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg"
    android:background="@color/surface">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unggah Dokumen / Struk"
        android:textSize="@dimen/text_lg"
        android:fontFamily="sans-serif-bold"
        android:textColor="@color/on_surface"
        android:layout_marginBottom="@dimen/spacing_md" />

    <!-- 1. Document Type Dropdown -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_doc_type"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tipe Dokumen"
        app:startIconDrawable="@drawable/ic_document"
        app:boxStrokeColor="@color/primary"
        app:boxCornerRadiusTopStart="@dimen/radius_md"
        app:boxCornerRadiusTopEnd="@dimen/radius_md"
        app:boxCornerRadiusBottomStart="@dimen/radius_md"
        app:boxCornerRadiusBottomEnd="@dimen/radius_md"
        android:layout_marginBottom="@dimen/spacing_md">

        <AutoCompleteTextView
            android:id="@+id/actv_doc_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 2. Drag & Drop / Click to Pick Box -->
    <LinearLayout
        android:id="@+id/layout_drop_zone"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:background="@drawable/bg_drag_drop_border"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_upload"
            app:tint="@color/primary"
            android:contentDescription="Upload Icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tarik file ke sini atau Klik untuk Memilih"
            android:textSize="@dimen/text_sm"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/primary"
            android:layout_marginTop="@dimen/spacing_xs" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mendukung JPG, PNG, PDF (Maks. 5MB)"
            android:textSize="@dimen/text_xs"
            android:textColor="@color/gray_500"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- 3. File Preview Box (Displayed below the upload form) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_file_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MariFin.CardView"
        app:cardElevation="@dimen/elevation_none"
        app:cardBackgroundColor="@color/surface_variant"
        app:contentPadding="@dimen/spacing_sm"
        android:layout_marginTop="@dimen/spacing_md"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_document"
                app:tint="@color/primary"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:contentDescription="Document" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_preview_file_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="struk_pembayaran.pdf"
                    android:textSize="@dimen/text_xs"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/on_surface"
                    android:singleLine="true"
                    android:ellipsize="middle" />

                <TextView
                    android:id="@+id/tv_preview_file_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.2 MB"
                    android:textSize="@dimen/text_2xs"
                    android:textColor="@color/gray_600" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_remove_preview"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                app:tint="@color/expense_red"
                android:contentDescription="Remove file" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="@dimen/spacing_lg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_upload"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_cancel"
            android:textColor="@color/gray_600"
            android:layout_marginEnd="@dimen/spacing_sm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_upload"
            style="@style/Widget.MariFin.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[✓] Simpan Dokumen" />
    </LinearLayout>

</LinearLayout>
