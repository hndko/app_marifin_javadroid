<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:title="FinGPT Asisten Finansial"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/ic_arrow_upward" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Quick Prompts Horizontal Scroll -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="@dimen/spacing_base"
            android:paddingVertical="@dimen/spacing_xs"
            android:background="@color/surface">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_prompts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_prompt_cashflow"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bagaimana arus kas saya?"
                    android:textColor="@color/primary" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_prompt_budget"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cek anggaran over budget"
                    android:textColor="@color/primary" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_prompt_tips"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tips hemat pengeluaran"
                    android:textColor="@color/primary" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Messages Recycler -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chat_messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_sm" />

        <!-- Typing Indicator -->
        <TextView
            android:id="@+id/tv_typing_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FinGPT sedang mengetik..."
            android:textSize="@dimen/text_xs"
            android:textColor="@color/gray_500"
            android:paddingHorizontal="@dimen/spacing_base"
            android:paddingBottom="@dimen/spacing_2xs"
            android:visibility="gone" />

        <!-- Chat Input Bar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MariFin.CardView"
            app:cardElevation="@dimen/elevation_high"
            app:cardCornerRadius="0dp"
            app:contentPadding="@dimen/spacing_xs">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/et_chat_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Tulis pesan atau catat transaksi..."
                    android:textSize="@dimen/text_sm"
                    android:background="@null"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="@dimen/spacing_sm"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="3" />

                <ImageButton
                    android:id="@+id/btn_send_chat"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_icon"
                    android:backgroundTint="@color/primary"
                    android:src="@drawable/ic_send"
                    app:tint="@color/white"
                    android:layout_marginEnd="@dimen/spacing_2xs"
                    android:contentDescription="Send Message" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
