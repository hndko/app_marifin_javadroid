<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg"
    android:background="@color/surface">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/spacing_md">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_robot"
            app:tint="@color/primary"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:contentDescription="FinGPT Bot" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Konfirmasi Transaksi AI"
                android:textSize="@dimen/text_base"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/on_surface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Periksa sebelum disimpan ke catatan"
                android:textSize="@dimen/text_2xs"
                android:textColor="@color/gray_500" />
        </LinearLayout>
    </LinearLayout>

    <!-- 1. Nominal Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_draft_amount"
        style="@style/Widget.MariFin.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nominal (Rp)"
        app:startIconDrawable="@drawable/ic_wallet_card"
        android:layout_marginBottom="@dimen/spacing_sm">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_draft_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 2. Account Dropdown -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_draft_account"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Pilih Rekening"
        app:startIconDrawable="@drawable/ic_bank"
        app:boxStrokeColor="@color/primary"
        app:boxCornerRadiusTopStart="@dimen/radius_md"
        app:boxCornerRadiusTopEnd="@dimen/radius_md"
        app:boxCornerRadiusBottomStart="@dimen/radius_md"
        app:boxCornerRadiusBottomEnd="@dimen/radius_md"
        android:layout_marginBottom="@dimen/spacing_sm">

        <AutoCompleteTextView
            android:id="@+id/actv_draft_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 3. Category Dropdown -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_draft_category"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Kategori Transaksi"
        app:startIconDrawable="@drawable/ic_category_default"
        app:boxStrokeColor="@color/primary"
        app:boxCornerRadiusTopStart="@dimen/radius_md"
        app:boxCornerRadiusTopEnd="@dimen/radius_md"
        app:boxCornerRadiusBottomStart="@dimen/radius_md"
        app:boxCornerRadiusBottomEnd="@dimen/radius_md"
        android:layout_marginBottom="@dimen/spacing_sm">

        <AutoCompleteTextView
            android:id="@+id/actv_draft_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 4. Description Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_draft_desc"
        style="@style/Widget.MariFin.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Catatan / Keterangan"
        app:startIconDrawable="@drawable/ic_note"
        android:layout_marginBottom="@dimen/spacing_lg">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_draft_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_draft"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_cancel"
            android:textColor="@color/gray_600"
            android:layout_marginEnd="@dimen/spacing_sm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_draft"
            style="@style/Widget.MariFin.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[✓] Konfirmasi &amp; Simpan" />
    </LinearLayout>

</LinearLayout>
