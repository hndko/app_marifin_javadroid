<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/Widget.MariFin.CardView"
    app:cardElevation="@dimen/elevation_low"
    android:layout_marginHorizontal="@dimen/spacing_base"
    android:layout_marginVertical="@dimen/spacing_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_base"
        android:gravity="center_vertical">

        <!-- File Icon Container -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_icon"
            android:backgroundTint="@color/surface_variant"
            android:layout_marginEnd="@dimen/spacing_md">

            <ImageView
                android:id="@+id/iv_doc_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_document"
                app:tint="@color/primary"
                android:contentDescription="File icon" />
        </FrameLayout>

        <!-- Document Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_doc_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Struk_Belanja_Alfamart.pdf"
                android:textSize="@dimen/text_sm"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/on_surface"
                android:singleLine="true"
                android:ellipsize="middle" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/spacing_2xs">

                <TextView
                    android:id="@+id/tv_doc_type_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Struk"
                    android:textSize="@dimen/text_2xs"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/primary"
                    android:background="@drawable/bg_badge_primary"
                    android:paddingHorizontal="@dimen/spacing_xs"
                    android:paddingVertical="2dp"
                    android:layout_marginEnd="@dimen/spacing_xs" />

                <TextView
                    android:id="@+id/tv_doc_size_and_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="245 KB • 20 Agu 2026"
                    android:textSize="@dimen/text_xs"
                    android:textColor="@color/gray_500" />
            </LinearLayout>
        </LinearLayout>

        <!-- Delete Button -->
        <ImageButton
            android:id="@+id/btn_doc_delete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            app:tint="@color/gray_400"
            android:layout_marginStart="@dimen/spacing_xs"
            android:contentDescription="@string/action_delete"
            android:tooltipText="@string/action_delete" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
