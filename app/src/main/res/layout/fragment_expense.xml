<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh_expense"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_2xl">

            <!-- Toolbar -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/primary"
                app:title="Analisis Pengeluaran"
                app:titleTextColor="@color/white" />

            <!-- Period Tabs -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_expense_period"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/primary"
                app:tabTextColor="@color/primary_light"
                app:tabSelectedTextColor="@color/white"
                app:tabIndicatorColor="@color/secondary"
                app:tabMode="fixed" />

            <!-- Total Expense Banner Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MariFin.CardView"
                app:cardElevation="@dimen/elevation_low"
                app:contentPadding="@dimen/spacing_lg"
                android:layout_margin="@dimen/spacing_base">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Pengeluaran Periode Ini"
                        android:textSize="@dimen/text_xs"
                        android:textColor="@color/gray_500" />

                    <TextView
                        android:id="@+id/tv_expense_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp0"
                        android:textSize="@dimen/text_2xl"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/expense_red"
                        android:layout_marginTop="@dimen/spacing_2xs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 6-Month Bar Chart Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MariFin.CardView"
                app:cardElevation="@dimen/elevation_low"
                app:contentPadding="@dimen/spacing_md"
                android:layout_marginHorizontal="@dimen/spacing_base"
                android:layout_marginBottom="@dimen/spacing_base">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tren Pengeluaran 6 Bulan"
                        android:textSize="@dimen/text_sm"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/on_surface"
                        android:layout_marginBottom="@dimen/spacing_xs" />

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/bar_chart_expense"
                        android:layout_width="match_parent"
                        android:layout_height="200dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Donut / Pie Chart Category Allocation Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MariFin.CardView"
                app:cardElevation="@dimen/elevation_low"
                app:contentPadding="@dimen/spacing_md"
                android:layout_marginHorizontal="@dimen/spacing_base"
                android:layout_marginBottom="@dimen/spacing_base">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alokasi Kategori Pengeluaran"
                        android:textSize="@dimen/text_sm"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/on_surface"
                        android:layout_marginBottom="@dimen/spacing_xs" />

                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/pie_chart_categories"
                        android:layout_width="match_parent"
                        android:layout_height="220dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Category Breakdown List Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rincian Pengeluaran per Kategori"
                android:textSize="@dimen/text_base"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/on_surface"
                android:paddingHorizontal="@dimen/spacing_base"
                android:layout_marginTop="@dimen/spacing_xs"
                android:layout_marginBottom="@dimen/spacing_xs" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_category_breakdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <!-- Empty State -->
            <TextView
                android:id="@+id/tv_expense_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Belum ada transaksi pengeluaran pada periode ini."
                android:textSize="@dimen/text_xs"
                android:textColor="@color/gray_500"
                android:gravity="center"
                android:padding="@dimen/spacing_xl"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
