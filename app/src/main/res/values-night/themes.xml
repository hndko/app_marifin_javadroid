<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Dark Theme for MariFin -->
    <style name="Theme.MariFin" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/secondary</item>
        <item name="colorOnPrimary">@color/gray_900</item>
        <item name="colorPrimaryContainer">@color/primary_dark</item>
        <item name="colorOnPrimaryContainer">@color/primary_light</item>

        <!-- Secondary Accent Colors -->
        <item name="colorSecondary">@color/secondary_light</item>
        <item name="colorOnSecondary">@color/gray_900</item>

        <!-- Surfaces and Backgrounds -->
        <item name="android:colorBackground">@color/gray_900</item>
        <item name="colorSurface">@color/gray_800</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/gray_700</item>
        <item name="colorOnSurfaceVariant">@color/gray_300</item>

        <!-- Status Bar & Navigation Bar -->
        <item name="android:statusBarColor">@color/gray_900</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/gray_800</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Component Styles -->
        <item name="materialCardViewStyle">@style/Widget.MariFin.CardView</item>
        <item name="materialButtonStyle">@style/Widget.MariFin.Button</item>
        <item name="textInputStyle">@style/Widget.MariFin.TextInputLayout</item>
    </style>

    <!-- Legacy Alias for compatibility -->
    <style name="Theme.App_marifin_javadroid" parent="Theme.MariFin" />
</resources>